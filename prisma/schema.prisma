generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  ADMIN
  EDITOR
}

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         AdminRole  @default(EDITOR)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

model Gallery {
  id          String         @id @default(cuid())
  pageSlug    String         @unique
  title       String
  description String         @default("")
  published   Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  images      GalleryImage[]
  auditLogs   AuditLog[]
}

model GalleryImage {
  id            String     @id @default(cuid())
  galleryId     String
  storageKey    String
  title         String
  description   String     @default("")
  altText       String
  mimeType      String?
  width         Int?
  height        Int?
  fileSize      Int?
  layoutVariant String     @default("standard")
  sortOrder     Int        @default(0)
  published     Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  gallery       Gallery    @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  auditLogs     AuditLog[]

  @@index([galleryId, published, sortOrder])
}

model Partner {
  id              String   @id @default(cuid())
  name            String
  websiteUrl      String?
  imageStorageKey String
  imageAltText    String
  imageMimeType   String?
  imageWidth      Int?
  imageHeight     Int?
  imageFileSize   Int?
  sortOrder       Int      @default(0)
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([published, sortOrder])
}

model LandingImage {
  id         String   @id @default(cuid())
  pageSlug   String   @unique
  storageKey String   @unique
  altText    String
  mimeType   String?
  width      Int?
  height     Int?
  fileSize   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model EventsBentoHome {
  id            String   @id @default(cuid())
  title         String
  detail        String   @default("")
  imageStorageKey String
  altText       String
  imageMimeType String?
  imageWidth    Int?
  imageHeight   Int?
  imageFileSize Int?
  featured      Boolean  @default(false)
  sortOrder     Int      @default(0)
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([published, featured, sortOrder])
  @@map("Event-Bento-Home")
}

model SponsorVideo {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  embedUrl    String
  sortOrder   Int      @default(0)
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, sortOrder])
}

model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  name      String
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

enum EventScheduleTrack {
  PUJO
  CULTURAL
}

/**
 * One row of the events page schedule. Rows are grouped by `dayLabel`
 * (e.g. "Day 1 — Shashthi") and rendered in one of the two side-by-side
 * tables depending on `track`.
 */
model EventScheduleItem {
  id        String             @id @default(cuid())
  track     EventScheduleTrack @default(PUJO)
  dayLabel  String
  title     String
  timeLabel String
  sortOrder Int                @default(0)
  published Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([published, track, dayLabel, sortOrder])
}

model HomeCountdown {
  id        String   @id @default("home")
  targetAt  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String        @id @default(cuid())
  action    String
  entity    String
  entityId  String
  details   Json?
  createdAt DateTime      @default(now())
  userId    String?
  galleryId String?
  imageId   String?
  user      AdminUser?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  gallery   Gallery?      @relation(fields: [galleryId], references: [id], onDelete: SetNull)
  image     GalleryImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}
