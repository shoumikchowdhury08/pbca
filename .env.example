DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pbca
AUTH_SECRET=replace-with-a-long-random-secret
PBCA_ADMIN_EMAIL=admin@pbca.in
PBCA_ADMIN_PASSWORD=change-this-before-production

# Cloudflare R2 (admin image uploads)
# S3 API credentials from the R2 dashboard; the browser uploads directly to R2
# with short-lived presigned URLs, so the bucket needs a CORS policy allowing
# PUT from the admin origin. The policy for this project is versioned in
# r2-cors.json at the repository root (see README for how to apply it).
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# EMAIL_USER is the Gmail account that sends the mail, receives every contact
# form submission (self-mail), and is shown as the sender of both messages.
EMAIL_USER=reachuspbcablr@gmail.com
# Gmail App Password (not the account password): https://myaccount.google.com/apppasswords
EMAIL_PASS=
